<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KhanFlix</title>
</head>
<style>

    *{
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body{
      background-color: black;
      color: white;
    }

    .main{
      height: 100%;

      background-image: url("https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTxfurnNr7NPsy5aDKpNBIu8Yg4qxSSAcrWNQ&s");
      background-position: center;
      position: relative;
    }

    

    .overlay{
      position: absolute;
      top: 0;
      width: 100%;
      height: 100%;

      background-color: rgba(0,0,0,0.7);
    }

    nav{
      width: 85%;
      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 80px;
      position: relative;
      z-index: 10;
    }

    .logo{
        text-shadow: 4px 4px black,5px 5px whitesmoke;
      color: rgb(194, 25, 25);
      font-size: 40px;
      font-weight: bold;
    }

    nav button{
    
      padding : 10px 20px;
      border: none;
      background-color: rgb(228, 51, 51);
      color: white;
      border-radius: 5px;
      cursor: pointer;
      font-size: 15px;
    }

    

    .hero{
      position: relative;
      z-index: 10;
      height: calc(100vh - 80px);
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;

      text-align: center;
      padding: 20px;
    }

    .hero h1{ text-shadow: 4px 4px black,5px 5px whitesmoke;
      font-size: 40px;
      font-weight: bold;
        color: rgb(185, 129, 25);
      font-size: 65px;
      max-width: 800px;
      font-weight: bolder;
      margin-bottom: 20px;
    }

    .hero p{
      font-size: 40px;
      font-weight: bold;
      color:  rgb(201, 176, 134);;
      font-size: 24px;
      margin-bottom: 20px;
    }

    .hero button{
      padding: 15px 30px;
      border: 2px solid rgb(134, 127, 127);
      color: rgb(163, 49, 49);
      background-color: rgb(114, 103, 103);
      color: white;
      font-weight: bolder;
      font-size: 20px;
      border-radius: 40px;
      cursor: pointer;
    }
.separator{
    
    height: 10px;
    background-color: rgb(206, 187, 187);
    
}

    .movies{
      padding: 60px 8%;
    }
.sticky{
    position: sticky;
    top: 0;
}
    .movies h2{
        color: rgb(187, 28, 28);
        text-shadow: 2px 4px rgb(252, 252, 252),3px 3px whitesmoke;
      font-size: 35px;
      margin-bottom: 30px;
    }

    .movie-container{
      display: flex;
      gap: 25px;
      flex-wrap: wrap;
    }

    .card{
      width: 220px;
      height: 320px;
      background-color: rgb(29, 26, 26);
      border-radius: 10px;
      overflow: hidden;
      transition: 0.4s;
    }

    .card:hover{
      transform: scale(1.1);
    }

    .card img{
      width: 100%;
      height: 80%;
      object-fit: cover;
    }

    .card h3{
      padding: 15px;
      text-align: center;
    }


</style>
<body>

  <div class="main">

    <div class="overlay"></div>

    <nav class="sticky">

      <div class="logo">KHANFLIX</div>

      <button>Sign In</button>

    </nav>

    <div class="hero">

      <h1>Watch Unlimited Movies & Web Series</h1>

      <p>Enjoy the latest action, thriller and intresting movies anytime.</p>
     
      <button>  <input required type="email" name="email" id="mail" placeholder="Enter email">&nbsp;&nbsp;&nbsp;Sign in</button>
    </div>
<div class="separator">

</div>

  </div>

  <section class="movies">

    <h2>Trending Movies</h2>

    <div class="movie-container">

      <div class="card">
        <img src="https://wallpapercave.com/wp/wp4056410.jpg">
        <h3>Avengers Endgame</h3>
      </div>

      <div class="card">
        <img src="https://wallpapercave.com/wp/wp1917154.jpg">
        <h3>Stranger Things</h3>
      </div>

      <div class="card">
        <img src="https://wallpapercave.com/uwp/uwp4969631.jpeg">
        <h3>Batman</h3>
      </div>

      <div class="card">
        <img src="https://wallpapercave.com/wp/wp5341119.jpg">
        <h3>John Wick</h3>
      </div>

      <div class="card">
        <img src="https://wallpapercave.com/wp/wp10691943.jpg">
        <h3>Ice Age : Continental Drift</h3>
      </div>

      <div class="card">
        <img src="https://wallpapercave.com/uwp/uwp4815820.jpeg">
        <h3>Spider Man</h3>
      </div>

    </div>

  </section>

</body>
</html>
