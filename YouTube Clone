<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>YouTube Clone</title>

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family:Arial, sans-serif;
    }

    body{
      background:#f1f1f1;
    }

    .navbar{
      width:100%;
      height:60px;
      background:white;
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:0 20px;
      position:fixed;
      top:0;
      left:0;
      box-shadow:0 2px 5px rgba(0,0,0,0.1);
      z-index:1000;
    }

    .logo{
      font-size:30px;
      color:red;
      font-weight:bold;
    }

    .search{
      width:40%;
      display:flex;
    }

    .search input{
      width:100%;
      padding:10px;
      border:1px solid #ccc;
      border-radius:20px 0 0 20px;
      outline:none;
    }

    .search button{
      padding:10px 20px;
      border:none;
      background:red;
      color:white;
      border-radius:0 20px 20px 0;
      cursor:pointer;
    }

    .profile{
      width:40px;
      height:40px;
      border-radius:50%;
      background:#ccc;
    }

    .sidebar{
      width:200px;
      height:100vh;
      background:white;
      position:fixed;
      top:60px;
      left:0;
      padding:20px;
    }

    .sidebar ul{
      list-style:none;
    }

    .sidebar ul li{
      padding:15px;
      border-radius:10px;
      cursor:pointer;
    }

    .sidebar ul li:hover{
      background:#eee;
    }


    .main{
      margin-left:220px;
      margin-top:80px;
      padding:20px;
    }

    .video-container{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
      gap:20px;
    }

    .video-card{
      background:white;
      border-radius:10px;
      overflow:hidden;
      text-decoration:none;
      color:black;
      transition:0.3s;
      box-shadow:0 2px 5px rgba(0,0,0,0.1);
    }

    .video-card:hover{
      transform:scale(1.03);
    }

    .video-card img{
      width:100%;
      height:180px;
      object-fit:cover;
    }

    .video-info{
      padding:15px;
    }

    .video-title{
      font-size:18px;
      font-weight:bold;
      margin-bottom:8px;
    }

    .channel{
      color:gray;
      font-size:14px;
    }

@media (max-width: 768px){

  .sidebar{
    width:70px;
    padding:10px;
  }

  .sidebar ul li{
    font-size:12px;
    text-align:center;
    padding:10px 5px;
  }

  .main{
    margin-left:80px;
    padding:10px;
  }

  .search{
    width:55%;
  }

  .video-container{
    grid-template-columns:1fr;
  }

  .video-card img{
    height:200px;
  }

}


@media (max-width: 500px){

  .navbar{
    flex-direction:column;
    height:auto;
    padding:10px;
    gap:10px;
  }

  .search{
    width:100%;
  }

  .sidebar{
    display:none;
  }

  .main{
    margin-left:0;
    margin-top:140px;
  }

  .video-card img{
    height:180px;
  }

}
  </style>
</head>
<body>

