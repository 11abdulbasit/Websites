<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Khan Arena</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#111;
    color:#fff;
}


header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:12px 15px;
    background:#1a1a1a;
    position:sticky;
    top:0;
    z-index:1000;
    flex-wrap:wrap;
}

.logo{
    font-size:28px;
    font-weight:bold;
    color:#9a8fa0;
    text-shadow:2px 3px black;
}


.search-box{
    flex:1;
    display:flex;
    justify-content:flex-end;
}

.search-box input{
    padding:10px;
    border:none;
    border-radius:6px;
    width:250px;
    max-width:100%;
    outline:none;
}


.hero{
    background-image:url("https://wallpapercave.com/wp/wp9223696.jpg");
    background-size:cover;
    background-position:center;
    height:450px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:20px;
}

.hero h1{
    font-size:clamp(28px, 6vw, 60px);
    text-shadow:2px 4px black;
}

.hero p{
    font-size:clamp(14px, 3.5vw, 20px);
    margin-top:10px;
    font-weight:bold;
    text-shadow:2px 2px black;
}


.categories{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:10px;
    padding:15px;
}

.categories button{
    padding:10px 18px;
    border:none;
    border-radius:25px;
    background:#222;
    color:white;
    cursor:pointer;
    transition:0.3s;
}

.categories button:hover{
    background:#00d4ff;
    color:black;
}


.games{
    padding:20px;
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));
    gap:15px;
}


.game-card{
    background:#1e1e1e;
    border-radius:12px;
    overflow:hidden;
    transition:0.3s;
}

.game-card:hover{
    transform:translateY(-6px);
}

.game-card img{
    width:100%;
    height:150px;
    object-fit:cover;
}

.game-card h3{
    padding:10px;
}

.game-card p{
    padding:0 10px 10px;
    color:#ccc;
}

.play-btn{
    width:100%;
    padding:10px;
    border:none;
    background:#00d4ff;
    font-weight:bold;
    cursor:pointer;
}

footer{
    background:#1a1a1a;
    text-align:center;
    padding:15px;
    margin-top:20px;
}


@media(max-width:700px){

header{
    flex-direction:column;
    gap:10px;
}

.search-box{
    width:100%;
    justify-content:center;
}

.search-box input{
    width:90%;
}

.hero{
    height:300px;
}

}
</style>
</head>

<body>

<header>
    <div class="logo">🎮 Khan Arena</div>

    <div class="search-box">
        <input type="text" id="search" placeholder="Search Games...">
    </div>
</header>

<section class="hero">
    <h1>Play Free Online Games</h1>
    <p>Action • Racing • Puzzle • Arcade • Sports</p>
</section>

<div class="categories">
    <button>Action</button>
    <button>Racing</button>
    <button>Puzzle</button>
    <button>Arcade</button>
    <button>Sports</button>
</div>

<section class="games" id="games">

<div class="game-card">
<img src="https://wallpapercave.com/wp/wp14652606.jpg">
<h3>Car Racing</h3>
<p>Fast racing challenge.</p>
<button class="play-btn">Play Now</button>
</div>

<div class="game-card">
<img src="https://wallpapercave.com/wp/wp13926269.jpg">
<h3>Space Shooter</h3>
<p>Destroy enemy ships.</p>
<button class="play-btn">Play Now</button>
</div>

<div class="game-card">
<img src="https://wallpapercave.com/uwp/uwp4973191.png">
<h3>Ninja Run</h3>
<p>Run and avoid obstacles.</p>
<button class="play-btn">Play Now</button>
</div>

<div class="game-card">
<img src="https://wallpapercave.com/fuwp-255/uwp4936878.png">
<h3>Puzzle Master</h3>
<p>Solve exciting puzzles.</p>
<button class="play-btn">Play Now</button>
</div>

<div class="game-card">
<img src="https://wallpapercave.com/uwp/uwp4957861.jpeg">
<h3>Football Pro</h3>
<p>Score amazing goals.</p>
<button class="play-btn">Play Now</button>
</div>

<div class="game-card">
<img src="https://wallpapercave.com/uwp/uwp4744805.png">
<h3>GTA V</h3>
<p>Street-level hustler.</p>
<button class="play-btn">Play Now</button>
</div>

<div class="game-card">
<img src="https://wallpapercave.com/uwp/uwp4195867.jpeg">
<h3>PUBG</h3>
<p>Enemies ahead.</p>
<button class="play-btn">Play Now</button>
</div>

<div class="game-card">
<img src="https://wallpapercave.com/wp/wp15222751.webp">
<h3>Zombie Attack</h3>
<p>Survive the zombie wave.</p>
<button class="play-btn">Play Now</button>
</div>

</section>

<footer>
    © 2026 Khan Arena | All Rights Reserved
</footer>

<script>
const search = document.getElementById("search");

search.addEventListener("keyup", function(){
    let value = this.value.toLowerCase();

    document.querySelectorAll(".game-card").forEach(card => {
        let title = card.querySelector("h3").textContent.toLowerCase();

        card.style.display = title.includes(value) ? "block" : "none";
    });
});
</script>

</body>
</html>
